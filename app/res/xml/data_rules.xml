<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloudbackup en overzetten naar een nieuwe telefoon, zonder de meldingsgeschiedenis. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="notification-history.db" />
        <exclude domain="database" path="notification-history.db-journal" />
        <exclude domain="database" path="notification-history.db-wal" />
        <exclude domain="database" path="notification-history.db-shm" />
        <exclude domain="sharedpref" path="notification_history.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="notification-history.db" />
        <exclude domain="database" path="notification-history.db-journal" />
        <exclude domain="database" path="notification-history.db-wal" />
        <exclude domain="database" path="notification-history.db-shm" />
        <exclude domain="sharedpref" path="notification_history.xml" />
    </device-transfer>
</data-extraction-rules>
