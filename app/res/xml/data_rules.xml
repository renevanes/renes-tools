<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloudbackup en overzetten naar een nieuwe telefoon, zonder gevoelige gegevens (zie backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="notification-history.db" />
        <exclude domain="database" path="notification-history.db-journal" />
        <exclude domain="database" path="notification-history.db-wal" />
        <exclude domain="database" path="notification-history.db-shm" />
        <exclude domain="file" path="wa/" />
        <exclude domain="file" path="call-recordings/" />
        <exclude domain="file" path="kluis/" />
        <exclude domain="file" path="transcripts/" />
        <exclude domain="file" path="tracks/" />
        <exclude domain="file" path="whisper/" />
        <exclude domain="file" path="contacts/" />
        <exclude domain="file" path="crash.log" />
        <exclude domain="file" path="web/" />
        <exclude domain="sharedpref" path="notification_history.xml" />
        <exclude domain="sharedpref" path="wabackup.xml" />
        <exclude domain="sharedpref" path="music.xml" />
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="sharedpref" path="txmeta.xml" />
        <exclude domain="sharedpref" path="call_recordings.xml" />
        <exclude domain="sharedpref" path="crash.xml" />
        <exclude domain="sharedpref" path="intent_token.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="notification-history.db" />
        <exclude domain="database" path="notification-history.db-journal" />
        <exclude domain="database" path="notification-history.db-wal" />
        <exclude domain="database" path="notification-history.db-shm" />
        <exclude domain="file" path="wa/" />
        <exclude domain="file" path="call-recordings/" />
        <exclude domain="file" path="kluis/" />
        <exclude domain="file" path="transcripts/" />
        <exclude domain="file" path="tracks/" />
        <exclude domain="file" path="whisper/" />
        <exclude domain="file" path="contacts/" />
        <exclude domain="file" path="crash.log" />
        <exclude domain="file" path="web/" />
        <exclude domain="sharedpref" path="notification_history.xml" />
        <exclude domain="sharedpref" path="wabackup.xml" />
        <exclude domain="sharedpref" path="music.xml" />
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="sharedpref" path="txmeta.xml" />
        <exclude domain="sharedpref" path="call_recordings.xml" />
        <exclude domain="sharedpref" path="crash.xml" />
        <exclude domain="sharedpref" path="intent_token.xml" />
    </device-transfer>
</data-extraction-rules>
