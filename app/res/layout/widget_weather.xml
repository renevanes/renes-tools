<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_bg"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_wi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="34sp" android:text="🌤️" />
        <TextView android:id="@+id/w_wt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp"
            android:textColor="#FFFFFFFF" android:textSize="30sp" android:textStyle="bold" android:text="--°" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/w_wd" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_ws" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_wdays" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp"
        android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
