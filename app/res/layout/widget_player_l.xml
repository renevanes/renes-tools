<?xml version="1.0" encoding="utf-8"?>
<!-- Speler-widget, groot: grote hoes, titel, voortgang en alle knoppen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_art" android:layout_width="76dp" android:layout_height="76dp"
            android:background="@drawable/widget_art" android:clipToOutline="true" android:scaleType="centerCrop"
            android:src="@drawable/ic_radio" android:contentDescription="Speler openen" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/w_kind" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF" android:textSize="11sp" android:textAllCaps="true" android:letterSpacing="0.12"
                android:maxLines="1" android:text="Speler" />
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold"
                android:maxLines="2" android:ellipsize="end" android:text="Speler" />
            <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#D9FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
                android:text="Tik om te kiezen" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/w_prog" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp"
        android:max="1000" android:progress="0" android:progressTint="#FFFFFFFF" android:progressBackgroundTint="#55FFFFFF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:orientation="horizontal" android:gravity="center">
        <ImageButton android:id="@+id/w_back" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/widget_btn" android:src="@drawable/ic_back" android:contentDescription="Terug" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/widget_btn" android:src="@drawable/ic_prev" android:contentDescription="Vorige" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/w_pp" android:layout_width="52dp" android:layout_height="52dp"
            android:background="@drawable/widget_play" android:src="@drawable/ic_play_dark" android:contentDescription="Afspelen of pauzeren" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/widget_btn" android:src="@drawable/ic_next" android:contentDescription="Volgende" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/w_fwd" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/widget_btn" android:src="@drawable/ic_fwd" android:contentDescription="Vooruit" />
    </LinearLayout>
</LinearLayout>
