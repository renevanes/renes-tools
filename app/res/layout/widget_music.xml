<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/m_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/widget_bg" android:padding="8dp">
    <ImageView android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/ic_music" android:contentDescription="Muziek herkennen" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="12sp" android:text="Herkennen" android:layout_marginTop="4dp" />
</LinearLayout>
