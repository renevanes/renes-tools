<?xml version="1.0" encoding="utf-8"?>
<!-- Speler-widget, klein: hoes, afspelen/pauze, volgende -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="6dp">
    <ImageView android:id="@+id/w_art" android:layout_width="36dp" android:layout_height="36dp"
        android:background="@drawable/widget_art" android:clipToOutline="true" android:scaleType="centerCrop"
        android:src="@drawable/ic_radio" android:contentDescription="Speler openen" />
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <ImageButton android:id="@+id/w_pp" android:layout_width="40dp" android:layout_height="40dp"
        android:background="@drawable/widget_play" android:src="@drawable/ic_play_dark" android:contentDescription="Afspelen of pauzeren" />
    <ImageButton android:id="@+id/w_next" android:layout_width="36dp" android:layout_height="36dp"
        android:layout_marginStart="4dp" android:background="@drawable/widget_btn" android:src="@drawable/ic_next" android:contentDescription="Volgende" />
</LinearLayout>
