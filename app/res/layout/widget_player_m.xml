<?xml version="1.0" encoding="utf-8"?>
<!-- Speler-widget, breed: hoes, titel, vorige/afspelen/volgende -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="8dp">
    <ImageView android:id="@+id/w_art" android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/widget_art" android:clipToOutline="true" android:scaleType="centerCrop"
        android:src="@drawable/ic_radio" android:contentDescription="Speler openen" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" android:text="Speler" />
        <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
            android:text="Tik om te kiezen" />
    </LinearLayout>
    <ImageButton android:id="@+id/w_prev" android:layout_width="38dp" android:layout_height="38dp"
        android:background="@drawable/widget_btn" android:src="@drawable/ic_prev" android:contentDescription="Vorige" />
    <ImageButton android:id="@+id/w_pp" android:layout_width="46dp" android:layout_height="46dp"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
        android:background="@drawable/widget_play" android:src="@drawable/ic_play_dark" android:contentDescription="Afspelen of pauzeren" />
    <ImageButton android:id="@+id/w_next" android:layout_width="38dp" android:layout_height="38dp"
        android:background="@drawable/widget_btn" android:src="@drawable/ic_next" android:contentDescription="Volgende" />
</LinearLayout>
