<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg"
    android:paddingStart="14dp" android:paddingEnd="10dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:text="🅿️" />
    <LinearLayout android:id="@+id/w_pinfo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/w_ptitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Parkeren" />
        <TextView android:id="@+id/w_pstate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/w_pstart" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center"
        android:background="@drawable/widget_chip" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:text="▶ Start" />
    <TextView android:id="@+id/w_popen" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:layout_marginStart="6dp"
        android:background="@drawable/widget_chip" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:textColor="#FFFFFFFF" android:textSize="14sp" android:text="App" />
</LinearLayout>
